# Copy this file to .env for local development.
# Put real provider credentials only in .env or your deployment secret manager.
# Never commit real keys.

# Core model providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Search and retrieval providers
TAVILY_API_KEY=
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Observability
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=omega-research-grid
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Local services
DATABASE_URL=postgresql+asyncpg://omega:omega@localhost:5432/omega
REDIS_URL=redis://localhost:6379/0
VECTOR_STORE_PROVIDER=chroma

# Runtime policy defaults
DEFAULT_MAX_USD=5.00
DEFAULT_MAX_WALL_SECONDS=900
DEFAULT_MAX_RECURSION_DEPTH=3
